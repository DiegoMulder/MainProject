/* ------------------------------------------------------------------
   Shared visual language for every game screen.
   Colours, type, spacing and states live here; C# only assigns classes.

   Direction: the house is the interface. No panels, no boxes. Words sit directly over the living Mansion,
   held readable only by soft shadow gradients at the screen edges. Titles in IM Fell, navigation in
   EB Garamond, functional values in Inter / Roboto Mono. Buttons are words: a thin crimson line draws
   itself under the one you are on, and a small mark slides in beside it.
   ------------------------------------------------------------------ */
/* Palette: near-black, charcoal, deep brown, aged ivory, a muted crimson used sparingly. */
:root {
    --bg: rgb(5, 4, 4);
    --panel: rgba(10, 8, 7, 0.9);
    --panel-edge: rgba(196, 184, 170, 0.12);
    --ivory: rgb(222, 215, 202);
    --text: rgb(206, 199, 187);
    --text-muted: rgb(139, 130, 120);
    --text-faint: rgb(92, 85, 79);
    --accent: rgb(132, 34, 32);
    --accent-bright: rgb(166, 54, 46);
    --accent-dim: rgba(132, 34, 32, 0.18);
    --ember: rgb(226, 219, 206);
    --danger: rgb(168, 70, 60);
    --danger-dim: rgba(132, 34, 32, 0.2);
    --blood: rgb(100, 16, 14);
    --space-xs: 4px;
    --space-s: 8px;
    --space-m: 16px;
    --space-l: 28px;
    --space-xl: 44px;
    -unity-font: url("../Fonts/Inter-Regular.ttf");
    color: var(--text);
    font-size: 18px;
}

/* ---------- Layers & screens ---------- */
.ui-root { flex-grow: 1; }
.layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.screen {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    align-items: center; justify-content: center;
    opacity: 1; translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.35s, 0.35s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}
.screen--hidden { display: none; }
/* Applied for one frame when a screen appears so it fades in and settles. */
.screen--enter { opacity: 0; translate: -12px 0; }
.screen--dim { background-color: rgba(3, 2, 2, 0.72); }
.screen--menu { background-color: var(--bg); }
.screen--backdrop { background-color: rgba(0, 0, 0, 0); align-items: stretch; justify-content: flex-start; }
.screen--shaded { background-color: rgba(3, 2, 2, 0.35); }
/* Pause and the end of a round: the world keeps moving behind, a little darker. */
.screen--pause { background-color: rgba(3, 2, 2, 0.5); align-items: stretch; justify-content: flex-start; }
.screen--end { background-color: rgba(3, 2, 2, 0.62); }

/* ---------- Edge shades (the only thing behind any text) ---------- */
.menu-shade { position: absolute; left: 0; top: 0; bottom: 0; width: 64%; -unity-background-scale-mode: stretch-to-fill; }
.menu-shade--right { left: auto; right: 0; width: 70%; }

/* ---------- The column ---------- */
.menu-side {
    position: absolute; left: 7%; top: 0; bottom: 0; width: 460px; max-width: 80%;
    justify-content: center;
}
.title-block { opacity: 1; transition-property: opacity; transition-duration: 2.6s; transition-timing-function: ease-in-out-sine; }
.title-block--dark { opacity: 0; }
.menu-kicker { -unity-font: url("../Fonts/EBGaramond-Variable.ttf"); font-size: 16px; letter-spacing: 7px; color: var(--accent-bright); margin-bottom: var(--space-xs); }
/* IM Fell: 17th-century engraved type. Old and unsettling without horror-font clichés. */
.menu-title {
    -unity-font: url("../Fonts/IMFellEnglishSC-Regular.ttf");
    font-size: 84px; letter-spacing: 4px; color: var(--ivory); width: 540px;
    -unity-text-align: upper-left; white-space: normal;
    text-shadow: 0 5px 26px rgba(0, 0, 0, 0.95);
    transition-property: opacity, color; transition-duration: 0.05s, 0.05s;
    margin-left: -4px;
}
.menu-title--small { font-size: 62px; letter-spacing: 3px; }
.menu-title--flicker { opacity: 0.4; color: rgb(150, 120, 112); }
.menu-rule { width: 64px; height: 1px; background-color: var(--accent-bright); margin: var(--space-m) 0; }
.menu-subtitle { -unity-font: url("../Fonts/EBGaramond-Variable.ttf"); font-size: 21px; color: var(--text-muted); letter-spacing: 1px; white-space: normal; }
.menu-note { -unity-font: url("../Fonts/EBGaramond-Variable.ttf"); -unity-font-style: italic; font-size: 16px; color: var(--text-faint); white-space: normal; max-width: 380px; margin-top: var(--space-xs); }
.menu-footer { position: absolute; left: 7%; bottom: var(--space-l); font-size: 12px; letter-spacing: 3px; color: var(--text-faint); }

/* ---------- Navigation: words, a drawn line, a sliding mark ---------- */
.menu-item-wrap { align-self: flex-start; margin: 2px 0; }
.btn.menu-item {
    height: 48px; margin: 0; padding: 0 2px;
    background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 0;
    color: var(--text-muted); font-size: 25px; letter-spacing: 7px;
    -unity-font: url("../Fonts/EBGaramond-Variable.ttf"); -unity-font-style: bold; -unity-text-align: middle-left;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9);
    transition-property: color, translate, letter-spacing;
    transition-duration: 0.22s, 0.22s, 0.3s; transition-timing-function: ease-out-cubic;
}
.menu-item__line {
    position: absolute; left: 2px; bottom: 7px; height: 1px; width: 0; background-color: var(--accent-bright);
    transition-property: width; transition-duration: 0.35s; transition-timing-function: ease-out-cubic;
}
.menu-item__mark {
    position: absolute; right: -30px; top: 0; bottom: 0; -unity-text-align: middle-left;
    -unity-font: url("../Fonts/EBGaramond-Variable.ttf"); font-size: 20px; color: var(--accent-bright);
    opacity: 0; translate: 10px 0;
    transition-property: opacity, translate; transition-duration: 0.25s, 0.25s; transition-timing-function: ease-out-cubic;
}
.menu-item-wrap--hot > .btn.menu-item { color: var(--ivory); translate: 6px 0; letter-spacing: 8px; }
.menu-item-wrap--hot > .menu-item__line { width: 100%; }
.menu-item-wrap--hot > .menu-item__mark { opacity: 1; translate: 0 0; }
.btn.menu-item:active { color: var(--accent-bright); }
.btn.menu-item:disabled { opacity: 0.28; }
.btn.menu-item--primary { color: var(--text); }
.btn.menu-item--danger { color: rgb(150, 96, 88); }
.menu-item-wrap--hot > .btn.menu-item--danger { color: var(--danger); }
/* The current options section keeps its line and mark. */
.menu-item-wrap--current > .btn.menu-item { color: var(--ivory); }
.menu-item-wrap--current > .menu-item__line { width: 100%; }
.menu-item-wrap--current > .menu-item__mark { opacity: 1; translate: 0 0; }
.menu-join { flex-direction: row; align-items: center; }
.menu-join > .menu-item-wrap { width: 150px; }

/* Links: small actions in the functional face, underlined; the line warms to crimson on hover. */
.btn.link {
    align-self: flex-start; height: 24px; margin: 0; padding: 0 1px;
    background-color: rgba(0, 0, 0, 0); border-width: 0; border-bottom-width: 1px; border-color: var(--text-faint); border-radius: 0;
    -unity-font: url("../Fonts/Inter-SemiBold.ttf"); font-size: 12px; letter-spacing: 3px; color: var(--text-muted);
    transition-property: color, border-color; transition-duration: 0.2s, 0.2s;
}
.btn.link:hover, .btn.link:focus { color: var(--ivory); border-color: var(--accent-bright); }
.btn.link--danger { color: var(--danger); }

/* ---------- Inputs: a line to write on, not a box ---------- */
.field { margin: var(--space-xs) 0 var(--space-s) 0; }
.field > .unity-base-field__input, .field TextElement { font-size: 19px; color: var(--ivory); }
.field > .unity-base-text-field__input {
    background-color: rgba(0, 0, 0, 0); border-width: 0; border-bottom-width: 1px; border-color: rgba(196, 184, 170, 0.28); border-radius: 0;
    height: 40px; padding: 0 2px;
    transition-property: border-color; transition-duration: 0.2s;
}
.field:hover > .unity-base-text-field__input { border-color: rgba(222, 215, 202, 0.5); }
.field:focus > .unity-base-text-field__input { border-color: var(--accent-bright); }
.field--code > .unity-base-text-field__input { -unity-font: url("../Fonts/RobotoMono-Regular.ttf"); letter-spacing: 6px; font-size: 20px; }
.field--inline { flex-grow: 1; margin: 0 0 0 var(--space-m); }
.status--left { -unity-text-align: middle-left; }

/* ---------- Overlays ---------- */
.grain { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.fade {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(0, 0, 0); opacity: 1;
    transition-property: opacity; transition-duration: 2.2s; transition-timing-function: ease-in-out-sine;
}
.fade--out { opacity: 0; }

/* ---------- Layout helpers ---------- */
.panel { background-color: var(--panel); padding: var(--space-l) var(--space-xl); width: 560px; max-width: 92%; max-height: 92%; }
.panel__header { margin-bottom: var(--space-m); }
.divider { height: 1px; background-color: var(--panel-edge); margin: var(--space-m) 0; }
.row { flex-direction: row; align-items: center; }
.row--spread { justify-content: space-between; }
.grow { flex-grow: 1; }
.spacer-s { height: var(--space-s); }
.spacer-m { height: var(--space-m); }
.spacer-l { height: var(--space-l); }

/* ---------- Typography ---------- */
.title { -unity-font: url("../Fonts/IMFellEnglishSC-Regular.ttf"); font-size: 56px; letter-spacing: 4px; color: var(--ivory); -unity-text-align: middle-center; margin-bottom: var(--space-xs); }
.subtitle { -unity-font: url("../Fonts/EBGaramond-Variable.ttf"); font-size: 20px; color: var(--text-muted); -unity-text-align: middle-center; letter-spacing: 1px; }
.heading { -unity-font: url("../Fonts/IMFellEnglishSC-Regular.ttf"); font-size: 34px; letter-spacing: 3px; color: var(--ivory); }
.label-caps { font-size: 13px; letter-spacing: 3px; color: var(--text-muted); margin-bottom: var(--space-xs); }
.body { font-size: 17px; color: var(--text); white-space: normal; }
.muted { color: var(--text-muted); }
.faint { color: var(--text-faint); font-size: 14px; white-space: normal; }
.mono { -unity-font: url("../Fonts/RobotoMono-Regular.ttf"); }
.status { font-size: 15px; color: var(--text-muted); white-space: normal; margin-top: var(--space-s); -unity-text-align: middle-center; }
.status--error { color: var(--danger); }
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* ---------- Plain buttons (kept for rare functional use) ---------- */
.btn {
    height: 40px; margin: var(--space-xs) 0; padding: 0 var(--space-m);
    background-color: rgba(0, 0, 0, 0); border-width: 0; border-bottom-width: 1px; border-color: var(--panel-edge); border-radius: 0;
    color: var(--text); font-size: 14px; letter-spacing: 3px;
    -unity-font: url("../Fonts/Inter-SemiBold.ttf"); -unity-text-align: middle-center;
    transition-property: border-color, color; transition-duration: 0.15s, 0.15s;
}
.btn:hover { color: var(--ivory); border-color: var(--accent-bright); }
.btn:disabled { opacity: 0.3; }

/* ---------- Sections (options, lobby) ---------- */
.section { margin-bottom: var(--space-xl); }
.section__head { flex-direction: row; align-items: center; margin-bottom: 2px; }
.section__title { -unity-font: url("../Fonts/IMFellEnglishSC-Regular.ttf"); font-size: 34px; letter-spacing: 3px; color: var(--ivory); text-shadow: 0 3px 14px rgba(0, 0, 0, 0.9); }
/* A hairline running out from the title and fading into the dark. */
.section__rule { flex-grow: 1; height: 1px; margin-left: var(--space-m); margin-top: 6px; background-color: rgba(196, 184, 170, 0.14); }
.section__count { -unity-font: url("../Fonts/RobotoMono-Regular.ttf"); font-size: 15px; color: var(--text-muted); margin-left: var(--space-m); margin-top: 6px; }
.section__desc { -unity-font: url("../Fonts/EBGaramond-Variable.ttf"); -unity-font-style: italic; font-size: 18px; color: var(--text-muted); white-space: normal; margin-bottom: var(--space-s); }

/* ---------- Settings rows ---------- */
.setting-row { flex-direction: row; align-items: center; min-height: 52px; padding: 4px 0 4px 16px; }
.setting-row:hover .setting-row__caption { color: var(--ivory); }
.setting-row__text { width: 46%; flex-shrink: 0; padding-right: var(--space-m); border-left-width: 1px; border-color: rgba(0, 0, 0, 0); margin-left: -16px; padding-left: 15px; transition-property: border-color; transition-duration: 0.2s; }
.setting-row:hover .setting-row__text { border-left-color: var(--accent-bright); }
.setting-row__caption { font-size: 17px; color: var(--text); transition-property: color; transition-duration: 0.2s; }
.setting-row__hint { -unity-font: url("../Fonts/EBGaramond-Variable.ttf"); font-size: 16px; color: var(--text-faint); white-space: normal; margin-top: 1px; }
.setting-row__control { flex-grow: 1; flex-direction: row; align-items: center; justify-content: flex-end; }
.setting__value { -unity-font: url("../Fonts/RobotoMono-Regular.ttf"); color: var(--ivory); font-size: 14px; width: 58px; -unity-text-align: middle-right; }

/* Slider: a hairline, a crimson thread up to a small diamond. */
.slider { flex-grow: 1; margin: 0 var(--space-s) 0 0; }
.slider .unity-base-slider__tracker { background-color: rgba(196, 184, 170, 0.16); border-width: 0; height: 1px; margin-top: 0; border-radius: 0; }
.slider__fill { position: absolute; left: 0; top: -1px; height: 3px; background-color: var(--accent); transition-property: background-color; transition-duration: 0.15s; }
.slider .unity-base-slider__dragger {
    background-color: var(--text); border-width: 0; width: 10px; height: 10px; margin-top: -5px; border-radius: 0; rotate: 45deg;
    transition-property: background-color, scale; transition-duration: 0.15s, 0.15s;
}
.slider:hover .unity-base-slider__dragger, .slider:focus .unity-base-slider__dragger { background-color: var(--ivory); scale: 1.35 1.35; }
.slider:hover .slider__fill, .slider:focus .slider__fill { background-color: var(--accent-bright); }
.slider:disabled { opacity: 0.28; }

/* Switch: the words ON and OFF; the chosen one is lit and underlined. */
.switch { margin: 0; }
.switch .unity-toggle__checkmark { display: none; }
.switch > .unity-toggle__input { flex-direction: row; align-items: center; background-color: rgba(0, 0, 0, 0); border-width: 0; }
.switch__word {
    -unity-font: url("../Fonts/Inter-SemiBold.ttf"); font-size: 13px; letter-spacing: 4px; margin-left: 18px; padding-bottom: 3px;
    color: var(--text-faint); border-bottom-width: 1px; border-color: rgba(0, 0, 0, 0);
    transition-property: color, border-color; transition-duration: 0.2s, 0.2s;
}
.switch__word--off { color: var(--ivory); border-bottom-color: var(--accent-bright); }
.switch--on .switch__word--on { color: var(--ivory); border-bottom-color: var(--accent-bright); }
.switch--on .switch__word--off { color: var(--text-faint); border-bottom-color: rgba(0, 0, 0, 0); }
.switch:hover .switch__word { color: var(--text-muted); }
.switch:hover .switch__word--off, .switch--on:hover .switch__word--on { color: var(--ivory); }
.switch--on:hover .switch__word--off { color: var(--text-muted); }
.switch:disabled { opacity: 0.3; }
.voice-status { margin-top: var(--space-s); }
.keys { -unity-font: url("../Fonts/RobotoMono-Regular.ttf"); font-size: 14px; color: var(--text-muted); margin-top: var(--space-s); }

/* ---------- Options ---------- */
.screen--options { background-color: rgba(3, 2, 2, 0.1); align-items: stretch; justify-content: flex-start; }
.screen--options-game { background-color: rgba(3, 2, 2, 0.66); }
.menu-side--options { width: 340px; }
.options-content { position: absolute; left: 36%; right: 8%; top: 14%; bottom: 8%; }
.options-page { flex-grow: 1; opacity: 1; translate: 0 0; transition-property: opacity, translate; transition-duration: 0.3s, 0.3s; transition-timing-function: ease-out-cubic, ease-out-cubic; }
.options-page--enter { opacity: 0; translate: 14px 0; }

/* ---------- Lobby ---------- */
.code-row { flex-direction: row; align-items: flex-end; margin-top: var(--space-m); }
.code { -unity-font: url("../Fonts/RobotoMono-Regular.ttf"); font-size: 44px; letter-spacing: 12px; color: var(--ivory); margin-right: var(--space-m); text-shadow: 0 3px 14px rgba(0, 0, 0, 0.9); }
.code-row > .btn.link { margin-bottom: 10px; }
.waiting { margin: var(--space-xs) 0 var(--space-s) 0; }
.lobby-side { position: absolute; right: 8%; top: 20%; width: 560px; max-width: 46%; }
.player-list { margin-top: var(--space-xs); }
.player-row { flex-direction: row; align-items: center; height: 40px; }
.player-row__seat { width: 52px; -unity-font: url("../Fonts/IMFellEnglishSC-Regular.ttf"); font-size: 20px; color: var(--accent-bright); }
.player-row__name { flex-grow: 1; flex-shrink: 1; -unity-font: url("../Fonts/EBGaramond-Variable.ttf"); font-size: 23px; color: var(--ivory); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9); }
.player-row__tag { -unity-font: url("../Fonts/Inter-SemiBold.ttf"); font-size: 11px; letter-spacing: 3px; color: var(--accent-bright); margin-left: var(--space-m); }
.player-row__tag--you { color: var(--text-muted); }
.player-row--empty .player-row__name { -unity-font-style: italic; font-size: 19px; color: var(--text-faint); }
.player-row--empty .player-row__seat { color: var(--text-faint); }

/* Selectors: the value between two thin arrows; never opens a list, so it can never run off-screen. */
.stepper { flex-direction: row; align-items: center; height: 50px; }
.stepper__label { width: 150px; font-size: 12px; letter-spacing: 4px; color: var(--text-muted); }
.stepper__value { flex-grow: 1; -unity-text-align: middle-center; -unity-font: url("../Fonts/EBGaramond-Variable.ttf"); -unity-font-style: bold; font-size: 25px; letter-spacing: 4px; color: var(--ivory); text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9); }
.btn.stepper__arrow {
    width: 40px; height: 40px; margin: 0; padding: 0 0 5px 0; border-width: 0; background-color: rgba(0, 0, 0, 0);
    -unity-font: url("../Fonts/EBGaramond-Variable.ttf"); font-size: 34px; color: var(--text-faint);
    transition-property: color, translate; transition-duration: 0.18s, 0.18s;
}
.btn.stepper__arrow:hover, .btn.stepper__arrow:focus { color: var(--accent-bright); }
.btn.stepper__arrow:disabled { opacity: 0.15; }
.stepper__detail { -unity-font: url("../Fonts/EBGaramond-Variable.ttf"); -unity-font-style: italic; font-size: 18px; color: var(--text-muted); -unity-text-align: middle-center; margin: var(--space-xs) 0 var(--space-s) 150px; }

/* ---------- End of round ---------- */
.end-title--won { color: var(--ivory); }
.end-title--lost { color: var(--danger); }

/* ---------- HUD ---------- */
.hud { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.crosshair { position: absolute; left: 50%; top: 50%; width: 6px; height: 6px; margin-left: -3px; margin-top: -3px; background-color: rgba(230, 222, 204, 0.8); border-width: 1px; border-color: rgba(0, 0, 0, 0.7); border-radius: 3px; }
.prompt { position: absolute; left: 0; right: 0; top: 56%; flex-direction: row; justify-content: center; align-items: center; transition-property: opacity; transition-duration: 0.1s; }
.prompt--hidden { opacity: 0; }
.key {
    -unity-font: url("../Fonts/RobotoMono-Regular.ttf"); font-size: 15px; color: var(--bg);
    background-color: var(--text); border-radius: 2px; min-width: 26px; height: 26px; padding: 0 6px;
    -unity-text-align: middle-center; margin-right: var(--space-s);
}
.prompt__text { font-size: 18px; color: var(--text); text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9); }
.prompt--unavailable .key { display: none; }
.prompt--unavailable .prompt__text { color: var(--text-muted); font-size: 16px; }

.hud-top-left { position: absolute; left: var(--space-l); top: var(--space-l); }
.hud-top-right { position: absolute; right: var(--space-l); top: var(--space-l); align-items: flex-end; }
.objective__title { font-size: 12px; letter-spacing: 3px; color: var(--text-muted); }
.objective__count { -unity-font: url("../Fonts/RobotoMono-Regular.ttf"); font-size: 26px; color: var(--text); }
.objective__hint { font-size: 14px; color: var(--text-muted); }
.objective--complete .objective__count { color: var(--ember); }

.hud-bottom { position: absolute; left: 0; right: 0; bottom: var(--space-l); flex-direction: row; justify-content: center; align-items: flex-end; }
.slot {
    width: 150px; height: 64px; margin: 0 var(--space-xs); padding: var(--space-s) var(--space-s);
    background-color: rgba(8, 7, 6, 0.7); border-width: 1px; border-color: rgba(216, 205, 180, 0.12); border-radius: 2px;
    transition-property: border-color, background-color, translate; transition-duration: 0.12s;
}
.slot--selected { border-color: var(--accent-bright); background-color: rgba(30, 16, 13, 0.88); translate: 0 -6px; }
.slot__header { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: var(--space-xs); }
.slot__number { -unity-font: url("../Fonts/RobotoMono-Regular.ttf"); font-size: 12px; color: var(--text-faint); }
.slot--selected .slot__number { color: var(--ember); }
.slot__name { font-size: 15px; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.slot--empty .slot__name { color: var(--text-faint); }
.slot__tag { font-size: 11px; letter-spacing: 2px; color: var(--text-muted); }
.slot__tag--on { color: var(--ember); }

.stamina { position: absolute; left: var(--space-l); bottom: var(--space-l); width: 200px; }
.stamina__track { height: 3px; background-color: rgba(222, 212, 190, 0.12); }
.stamina__fill { height: 3px; background-color: rgba(222, 212, 190, 0.65); width: 100%; }
.stamina--low .stamina__fill { background-color: var(--danger); }
.hints { position: absolute; right: var(--space-l); bottom: var(--space-l); align-items: flex-end; }
.hints Label { font-size: 13px; color: var(--text-faint); letter-spacing: 1px; }

/* ---------- Downed / spectator ---------- */
.vignette { position: absolute; left: -25%; top: -25%; right: -25%; bottom: -25%; -unity-background-scale-mode: stretch-to-fill; }
.downed { position: absolute; left: 0; right: 0; top: 30%; align-items: center; }
.downed__title { -unity-font: url("../Fonts/IMFellEnglishSC-Regular.ttf"); font-size: 48px; letter-spacing: 6px; color: rgb(226, 196, 186); text-shadow: 0 2px 6px rgba(0, 0, 0, 0.9); }
.downed__text { font-size: 17px; color: rgb(205, 186, 176); margin-top: var(--space-s); -unity-text-align: middle-center; white-space: normal; max-width: 600px; text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9); }
.bleed { width: 340px; margin-top: var(--space-l); }
.bleed__row { flex-direction: row; justify-content: space-between; margin-bottom: var(--space-xs); }
.bleed__label { font-size: 12px; letter-spacing: 3px; color: rgb(205, 170, 160); }
.bleed__time { -unity-font: url("../Fonts/RobotoMono-Regular.ttf"); font-size: 15px; color: rgb(235, 210, 200); }
.bleed__track { height: 4px; background-color: rgba(0, 0, 0, 0.6); }
.bleed__fill { height: 4px; background-color: rgb(186, 38, 32); }

.spectator { position: absolute; left: 0; right: 0; top: var(--space-l); align-items: center; }
.spectator__label { font-size: 12px; letter-spacing: 4px; color: var(--text-muted); }
.spectator__name { -unity-font: url("../Fonts/Inter-SemiBold.ttf"); font-size: 26px; letter-spacing: 3px; max-width: 700px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* ---------- End / loading ---------- */
.loading__dot { width: 8px; height: 8px; background-color: var(--accent-bright); margin-top: var(--space-m); border-radius: 1px; transition-property: opacity; transition-duration: 0.6s; }
.loading__dot--dim { opacity: 0.15; }
.debug { font-size: 12px; color: var(--text-faint); -unity-font: url("../Fonts/RobotoMono-Regular.ttf"); }
